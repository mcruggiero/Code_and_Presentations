from datetime import datetime, timedelta

cutoff = (datetime.now() - timedelta(days=30)).strftime('%Y-%m-%d')
query = {
    "query": {
        "range": {
            "created": {
                "lt": cutoff
            }
        }
    }
}

response = client.delete_by_query(index="soft_string", body=query)
print(f"Deleted {response['deleted']} documents older than {cutoff}.")


