import os
import subprocess
import time
from opensearchpy import OpenSearch

# ================================
# 🚀 STEP 1: DOWNLOAD OPENSEARCH (Only if Needed)
# ================================
def download_opensearch():
    lib_path = "../lib/opensearch-2.11.0"  # Move OpenSearch one directory up
    tar_file = "../lib/opensearch-2.11.0-linux-x64.tar.gz"

    if not os.path.exists(lib_path):
        print("📥 Downloading OpenSearch...")
        os.makedirs("../lib", exist_ok=True)  # Ensure the lib directory exists

        # Download OpenSearch to ../lib/
        subprocess.run([
            "wget", "-O", tar_file, 
            "https://artifacts.opensearch.org/releases/bundle/opensearch/2.11.0/opensearch-2.11.0-linux-x64.tar.gz"
        ], check=True)

        # Extract it into ../lib/
        subprocess.run(["tar", "-xzf", tar_file, "-C", "../lib"], check=True)
    
    return lib_path

# ================================
# 🚀 STEP 2: START OPENSEARCH
# ================================
def start_opensearch():
    opensearch_path = download_opensearch()
    print("🚀 Starting OpenSearch...")

    process = subprocess.Popen([
        f"{opensearch_path}/bin/opensearch",
        "-E", "discovery.type=single-node",
        "-E", "plugins.security.disabled=true"
    ], stdout=subprocess.PIPE, stderr=subprocess.PIPE)

    time.sleep(10)  # Wait for OpenSearch to fully start
    return process

# ================================
# 🚀 STEP 3: CONNECT TO OPENSEARCH
# ================================
def connect_opensearch():
    client = OpenSearch(
        hosts=[{"host": "localhost", "port": 9200}],
        http_compress=True
    )
    print("✅ Connected to OpenSearch")
    print(client.info())  # Display OpenSearch info
    return client

# ================================
# 🚀 STEP 4: CREATE INDEX & INSERT DATA
# ================================
def create_index_and_insert_data(client):
    index_name = "test_index"

    # Check if index exists, create if not
    if not client.indices.exists(index=index_name):
        client.indices.create(index=index_name)
        print(f"✅ Index '{index_name}' created.")

    # Insert a test document
    doc = {"title": "Pure Python OpenSearch", "content": "Running OpenSearch without Docker!"}
    client.index(index=index_name, body=doc)
    print("📄 Document inserted.")

# ================================
# 🚀 STEP 5: SEARCH FOR DATA
# ================================
def search_data(client):
    index_name = "test_index"
    query = {"query": {"match_all": {}}}
    
    response = client.search(index=index_name, body=query)
    print("🔍 Search Results:", response["hits"]["hits"])

# ================================
# 🚀 STEP 6: STOP OPENSEARCH
# ================================
def stop_opensearch(process):
    process.terminate()
    print("🛑 OpenSearch stopped.")

# ================================
# 🚀 RUN EVERYTHING
# ================================
if __name__ == "__main__":
    os_process = start_opensearch()  # Start OpenSearch
    os_client = connect_opensearch()  # Connect to OpenSearch
    create_index_and_insert_data(os_client)  # Create index & insert data
    search_data(os_client)  # Search for data
    stop_opensearch(os_process)  # Stop OpenSearch


def must_contain_multi_match(client, index_name, search_term):
    """Search multiple columns where the term MUST be present in at least one."""
    query = {
        "query": {
            "bool": {
                "must": [  # Ensures the term MUST appear in at least one field
                    {
                        "multi_match": {
                            "query": search_term,
                            "fields": ["scenario_name", "scenario_description", "variant", "string_list"],
                            "type": "best_fields"  # Uses BM25 ranking
                        }
                    }
                ]
            }
        }
    }

    response = client.search(index=index_name, body=query)
    return response["hits"]["hits"]



import os
import subprocess
import time
from elasticsearch import Elasticsearch

# Define paths
ES_VERSION = "8.6.0"
ES_DOWNLOAD_URL = f"https://artifacts.elastic.co/downloads/elasticsearch/elasticsearch-{ES_VERSION}-linux-x86_64.tar.gz"
ES_DIR = f"elasticsearch-{ES_VERSION}"
ES_TAR = f"{ES_DIR}.tar.gz"

# Check if Elasticsearch is already downloaded
if not os.path.exists(ES_TAR):
    print("Downloading Elasticsearch...")
    subprocess.run(["wget", ES_DOWNLOAD_URL])

# Check if already extracted
if not os.path.exists(ES_DIR):
    print("Extracting Elasticsearch...")
    subprocess.run(["tar", "-xzf", ES_TAR])

# Define the command to run Elasticsearch in the background
es_command = [f"./{ES_DIR}/bin/elasticsearch"]

# Run Elasticsearch as a subprocess
print("Starting Elasticsearch...")
es_process = subprocess.Popen(es_command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

# Wait for Elasticsearch to start
time.sleep(15)  # Adjust based on system speed

# Connect to Elasticsearch
es = Elasticsearch("http://localhost:9200")

if es.ping():
    print("Elasticsearch is running!")
else:
    print("Failed to connect to Elasticsearch.")

