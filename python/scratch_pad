# BULK INSERTING MULTIPLE DOCUMENTS
from uuid import uuid4
from opensearchpy.helpers import bulk

docs = [
    {
        "_index": "soft_string",
        "_id": str(uuid4()),
        "_source": {
            "name": f"BulkDoc_{i}",
            "creator": "Bulk Inserter",
            "created": "2025-04-03",
            "step_json": [],
            "step_count": 0
        }
    }
    for i in range(5)
]

# Perform the bulk insert
bulk(client, docs)
print("Bulk insert complete.")

query = {
    "size": 0,
    "aggs": {
        "by_status": {
            "terms": {
                "field": "review_status"
            }
        }
    }
}

response = client.search(index="soft_string", body=query)
print("Review status counts:")
for bucket in response["aggregations"]["by_status"]["buckets"]:
    print(f"{bucket['key']}: {bucket['doc_count']}")

# Create a new index with alias
client.indices.create(index="soft_string_v2", body={"aliases": {"soft_string_current": {}}})
print("Created index 'soft_string_v2' with alias 'soft_string_current'.")

# Switch alias from old index to new
actions = [
    { "remove": { "index": "soft_string", "alias": "soft_string_current" }},
    { "add": { "index": "soft_string_v2", "alias": "soft_string_current" }}
]

client.indices.update_aliases({ "actions": actions })
print("Alias 'soft_string_current' now points to 'soft_string_v2'.")

query = {
    "query": {
        "match": {
            "step_json.Step Description": "Validate"
        }
    },
    "highlight": {
        "fields": {
            "step_json.Step Description": {}
        }
    }
}

response = client.search(index="soft_string", body=query)
for hit in response["hits"]["hits"]:
    print("Highlight:", hit.get("highlight"))

query = {
