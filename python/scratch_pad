query = {
  "query": {
    "nested": {
      "path": "step_json",
      "query": {
        "match": {
          "step_json.Step Description": "Validate"
        }
      },
      "inner_hits": {
        "highlight": {
          "fields": {
            "step_json.Step Description": {}
          }
        }
      }
    }
  }
}

response = client.search(index="soft_string", body=query)

for hit in response["hits"]["hits"]:
    inner = hit.get("inner_hits", {})
    if "step_json" in inner:
        for inner_hit in inner["step_json"]["hits"]["hits"]:
            print("Highlighted:", inner_hit.get("highlight", {}))
