# Step 2: Create hidden index
if not os_client.indices.exists(index=HIDDEN_INDEX):
    os_client.indices.create(index=HIDDEN_INDEX, body=mapping)
    print(f"Created index: {HIDDEN_INDEX}")
else:
    print(f"Index {HIDDEN_INDEX} already exists.")

# Step 3: Prevent Deletes
os_client.indices.put_settings(
    index=HIDDEN_INDEX,
    body={"settings":
          {
              "index.blocks.delete": True
          }
)

# Step 4: Create alias for safer writes
os_client.indices.update_aliases(body={
    "actions": [
        { "add": { "index": HIDDEN_INDEX, "alias": ALIAS_NAME } }
    ]
})
print(f"Created alias: {ALIAS_NAME} -> {HIDDEN_INDEX}")
