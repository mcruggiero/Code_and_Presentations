import streamlit as st
import pandas as pd
import os
import sys
import importlib
import json

# Load Excelsior Module
project_root = os.path.abspath(os.path.join(os.getcwd(), ".."))
sys.path.append(os.path.join(project_root, "src"))

import excelsior_es
importlib.reload(excelsior_es)
from excelsior_es import Excelsior

# Initialize Excelsior
ex = Excelsior()
ex.main()

# Title of the app
st.title("Welcome to the Excelsior Test App!")
st.subheader("Test Portfolio")

# Search box
search_term = st.text_input("Enter a search term:")

if search_term:
    # Execute search
    results = ex.general_portfolio_search(search_term, search_index=ex.portfolio_index_name)
    results = [x["_source"] for x in results]  # Extract only the "_source" field

    if results:
        # Display in collapsible JSON format
        st.subheader("Search Results (Formatted View)")
        st.json(results)

        # Display in a scrollable raw JSON box
        formatted_json = json.dumps(results, indent=4)
        st.subheader("Raw JSON Output")
        st.text_area("Raw JSON:", formatted_json, height=300)
    else:
        st.write("No matching results found.")
