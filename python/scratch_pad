from opensearchpy.test import OpenSearchTestCase
from opensearchpy import OpenSearch

# Create a test instance
class OpenSearchInMemory(OpenSearchTestCase):
    def setUp(self):
        super().setUp()
        self.client = self._get_client()

# Instantiate In-Memory OpenSearch
test_opensearch = OpenSearchInMemory()
client = test_opensearch.client

# Create an index
index_name = "test_index"
client.indices.create(index=index_name, ignore=400)

# Insert a document
doc = {"title": "In-Memory Test", "content": "Testing OpenSearch in Jupyter"}
client.index(index=index_name, body=doc)

# Search
response = client.search(index=index_name, body={"query": {"match_all": {}}})
print(response)
