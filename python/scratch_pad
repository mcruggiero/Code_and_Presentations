# Combined query: fuzzy match in ai_text AND exact phrase in path
# ---------------------------------------------------------------
# This example shows a `bool` query with two `must` clauses:
# - A fuzzy `match` query on the `ai_text` field (full-text search, allowing typos)
# - An exact `match_phrase` on the `path` field (must contain the exact string "itc-3")

combined_query = {
    "query": {
        "bool": {
            "must": [
                {
                    "match": {
                        "ai_text": {
                            "query": "log into sap",   # Approximate search term
                            "fuzziness": "AUTO"
                        }
                    }
                },
                {
                    "match_phrase": {
                        "path": "itc-3"  # Exact phrase match in the path
                    }
                }
            ]
        }
    }
}

response = client.search(index="ai_string_tests", body=combined_query)

print("Documents with fuzzy match in ai_text and exact phrase 'itc-3' in path:")
for hit in response["hits"]["hits"]:
    print("Path:", hit["_source"]["path"])
    print("Excerpt from ai_text:", hit["_source"]["ai_text"][:300])  # Preview only
    print("---")
