from datetime import datetime
from opensearchpy import OpenSearch, helpers
import uuid

# 1. Initialize the OpenSearch client
client = OpenSearch(
    hosts=[{"host": "localhost", "port": 9200}],
    http_auth=("admin", "admin"),
    use_ssl=False
)

# 2. Define names
source_index = "soft_string"
timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
backup_index = f"{source_index}_backup_{timestamp}"
alias_name = f"{source_index}_current"

# 3. Create backup index (with same mapping)
mapping = client.indices.get_mapping(index=source_index)[source_index]["mappings"]
settings = client.indices.get_settings(index=source_index)[source_index]["settings"]["index"]
settings_to_copy = {
    "settings": {
        "number_of_shards": int(settings["number_of_shards"]),
        "number_of_replicas": int(settings["number_of_replicas"]),
        "index.mapping.total_fields.limit": int(settings.get("mapping", {}).get("total_fields", {}).get("limit", 1000))
    },
    "mappings": mapping
}

client.indices.create(index=backup_index, body=settings_to_copy)
print(f"Created backup index: {backup_index}")

# 4. Reindex from source to backup
reindex_body = {
    "source": {"index": source_index},
    "dest": {"index": backup_index}
}
client.reindex(body=reindex_body, wait_for_completion=True)
print(f"Copied documents from {source_index} to {backup_index}")

# 5. Update alias: point alias to backup index (optional)
# Remove existing alias from any index and point it to the backup
aliases = client.indices.get_alias(name=alias_name, ignore=404)
actions = []

if aliases and isinstance(aliases, dict):
    for old_index in aliases:
        actions.append({"remove": {"index": old_index, "alias": alias_name}})

actions.append({"add": {"index": backup_index, "alias": alias_name}})

client.indices.update_aliases({"actions": actions})
print(f"Alias '{alias_name}' now points to {backup_index}")
