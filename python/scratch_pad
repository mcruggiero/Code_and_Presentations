# Fuzzy search inside a JSON string field using dot notation
# and an exact phrase match on the 'path' field.

# Assumes 'ai_json.0.Step Description' is NOT mapped as a nested type.
# If it is a nested type, a different structure is required (using a nested query).

query = {
    "query": {
        "bool": {
            "must": [
                {
                    "match": {
                        "ai_json.0.Step Description": {
                            "query": "login sap hana",  # Approximate string to match fuzzily
                            "fuzziness": "AUTO"
                        }
                    }
                },
                {
                    "match_phrase": {
                        "path": "itc-3"  # Exact phrase must appear in the path field
                    }
                }
            ]
        }
    }
}

response = client.search(index="ai_string_tests", body=query)

print("Results for fuzzy match inside ai_json and exact 'itc-3' in path:")
for hit in response["hits"]["hits"]:
    print("Path:", hit["_source"].get("path"))
    step = hit["_source"].get("ai_json", {}).get("0", {}).get("Step Description", "")
    print("Step Description:", step)
    print("---")
