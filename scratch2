from elasticsearch import Elasticsearch, helpers
import uuid
import re

# === Connect to your OpenSearch / Elasticsearch cluster ===
os_client = Elasticsearch("http://localhost:9200")

# === Constants ===
OLD_ALIAS = "main_index"
NEW_ALIAS = "dev_index"
SCROLL_TIME = "2m"
BATCH_SIZE = 500
NAMESPACE = uuid.NAMESPACE_URL  # Use a stable namespace for consistent uuid5 generation

# Step 0: Delete all documents from dev_index
print(f"Deleting all documents from {NEW_ALIAS}...")

os_client.delete_by_query(
    index=NEW_ALIAS,
    body={
        "query": {
            "match_all": {}
        }
    },
    conflicts="proceed",
    refresh=True
)

print(f"All documents deleted from {NEW_ALIAS}")

# Step 1: Scroll all documents from main_index
results = []
scroll = os_client.search(
    index=OLD_ALIAS,
    scroll=SCROLL_TIME,
    size=BATCH_SIZE,
    body={"query": {"match_all": {}}}
)

scroll_id = scroll["_scroll_id"]
hits = scroll["hits"]["hits"]
results.extend(hits)

while len(hits) > 0:
    scroll = os_client.scroll(scroll_id=scroll_id, scroll=SCROLL_TIME)
    scroll_id = scroll["_scroll_id"]
    hits = scroll["hits"]["hits"]
    results.extend(hits)

print(f"Total documents to reindex: {len(results)}")

# Step 2: Reindex with uuid5-based IDs
actions = []

for doc in results:
    source = doc["_source"]

    try:
        version_match = re.search(r"_v\d{3}$", source.get("os_index", ""))
        suffix = version_match.group(0) if version_match else "_v000"

        # Build raw ID string for deterministic UUID
        raw_string = f"{source['portfolio']}\n{source['path']}\n{source['test_case_name']}{suffix}"
        new_id = str(uuid.uuid5(NAMESPACE, raw_string))

        actions.append({
            "_index": NEW_ALIAS,
            "_id": new_id,
            "_source": source
        })

    except KeyError as e:
        print(f"Skipping doc due to missing key: {e}")
        continue

# Step 3: Bulk insert into dev_index
helpers.bulk(os_client, actions)
print(f"Reindexed {len(actions)} documents to {NEW_ALIAS} using uuid5 IDs.")
