colors = colors.set_index("sid_key")

financial_performance = financial_performance.set_index("sid_key")

colors_dict = colors.T.to_dict()
financial_performance_dict = financial_performance.T.to_dict()

complete_info = {}
for sid_key in colors_dict.keys():
    
    if sid_key in colors_dict and sid_key in financial_performance_dict:
        complete_info[sid_key] = {**colors_dict[sid_key], **financial_performance_dict[sid_key]}
    else:
        complete_info[sid_key] = colors_dict[sid_key]

df_dict = detail.T.to_dict()

success_count = {"fail":0, "success":0, "retries":0} 
for index, value in df_dict.items():
    
    sid_key = value["sid_key"]
    
    if sid_key in complete_info:
        
        df_dict[index] = {**value, **complete_info[sid_key]}
        success_count["success"] += 1
    
    else:
        
        month_tries = [x for x in range(1,14)] + [-1,-2,-3]
        for i in month_tries:
            
            sid_split = sid_key.split(".")
            date = pd.Timestamp(f'{sid_split[1]}-{sid_split[2]}-01')
            one_less_month = date - pd.DateOffset(months=i)
            one_less_month = one_less_month.strftime('%Y.%m')
            
            new_sid_key = f"{sid_split[0]}.{one_less_month}"
            
            if new_sid_key in complete_info:
                
                df_dict[index] = {**value, **complete_info[new_sid_key]}
                success_count["retries"] += 1
                break
            
            if i == -3:
                success_count["fail"] += 1
                
df = pd.DataFrame(df_dict).T
