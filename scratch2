from opensearchpy import OpenSearch

# Initialize your OpenSearch client
os_client = OpenSearch(
    hosts=[{"host": "localhost", "port": 9200}],
    http_auth=("admin", "admin"),  # Update as needed
    use_ssl=False,
    verify_certs=False
)

# Step 1: Create the hidden index (with dot prefix)
HIDDEN_INDEX = ".hackaton"
ALIAS_NAME = "hackaton_write"

# Replace this with your full mapping
your_mapping = {
    "mappings": {
        "properties": {
            "test_case_name": { "type": "text" }
            # ... insert your full mapping here
        }
    }
}

# Create hidden index if it doesn't exist
if not os_client.indices.exists(index=HIDDEN_INDEX):
    os_client.indices.create(index=HIDDEN_INDEX, body=your_mapping)
    print(f"✅ Created hidden index: {HIDDEN_INDEX}")
else:
    print(f"ℹ️ Index {HIDDEN_INDEX} already exists.")

# Step 2: Attach no-delete lifecycle policy
policy_id = "hackaton-no-delete"
policy_body = {
    "policy": {
        "description": "Never delete this index",
        "default_state": "ingest",
        "states": [
            {
                "name": "ingest",
                "actions": [],
                "transitions": []
            }
        ],
        "ism_template": {
            "index_patterns": [HIDDEN_INDEX],
            "priority": 100
        }
    }
}

# Create the policy (if OpenSearch ISM plugin is enabled)
try:
    os_client.transport.perform_request(
        "PUT",
        f"/_plugins/_ism/policies/{policy_id}",
        body=policy_body
    )
    print("✅ ISM policy created.")

    # Attach policy to the index
    os_client.indices.put_settings(
        index=HIDDEN_INDEX,
        body={"settings": {"opendistro.index_state_management.policy_id": policy_id}}
    )
    print("✅ Attached ISM no-delete policy.")
except Exception as e:
    print("⚠️ Could not apply ISM policy. Make sure ISM plugin is enabled.")
    print(e)

# Step 3: Create an alias for writing
alias_body = {
    "actions": [
        {
            "add": {
                "index": HIDDEN_INDEX,
                "alias": ALIAS_NAME
            }
        }
    ]
}

os_client.indices.update_aliases(body=alias_body)
print(f"✅ Created alias: {ALIAS_NAME} → {HIDDEN_INDEX}")
