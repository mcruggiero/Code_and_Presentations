all_v000_docs = []

response = client.search(
    index="hackaton_write",
    scroll="2m",
    size=500,
    _source=True,
    body={"query": {"match_all": {}}}
)

scroll_id = response["_scroll_id"]
hits = response["hits"]["hits"]

while hits:
    for hit in hits:
        if hit["_id"].endswith("_v000"):
            all_v000_docs.append(hit)

    # Fetch next scroll batch
    response = client.scroll(scroll_id=scroll_id, scroll="2m")
    scroll_id = response["_scroll_id"]
    hits = response["hits"]["hits"]

print(f"📦 Collected {len(all_v000_docs)} original documents (_v000)")
