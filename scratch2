SQL_QUERY = """
SELECT

    /* Notes */
    Scorecard_Detail.Scorecard_Detail_SID AS SID,

    Scorecard_Detail_Note.Scorecard_Detail_Note_SID,
    Scorecard_Detail_Note.Scorecard_Note,
    YEAR(Scorecard_Detail_Note.Modified_Date) AS Note_Year,
    RIGHT(
        '0'  + CONVERT(VARCHAR(2), 
        Month( Scorecard_Detail_Note.Modified_Date )), 2) AS Note_Month,
            
    /* Details */
    Scorecard_Detail.PO_Number,
    Scorecard_Detail.PO_Contract_Type,
    Scorecard_Detail.PO_Complexity_Level,
    Scorecard_Detail.PO_Lifecycle_Phase,
    Scorecard_Detail.Supplier_Name,
    Scorecard_Detail.LM_Vendor_ID,
    Scorecard_Detail.Supplier_Site_Location,
    Scorecard_Detail.Supplier_DandB_Number,
    Scorecard_Detail.LOB_Name,
    Scorecard_Detail.Program_Name,
    Scorecard_Detail.Prime_Contract_Number,
    Scorecard_Detail.Program_Contract_Type,
    Scorecard_Detail.PO_Contract_Dollars_Mil,
    Scorecard_Detail.PO_Funding_Dollars_Mil,
    Scorecard_Detail.PO_Definitization_Status,
    Scorecard_Detail.UCA_Start_Date,
    Scorecard_Detail.UCA_Age,
    Scorecard_Detail.EVM_Ind,
    Scorecard_Detail.PO_Funding_Override_Ind,
    Scorecard_Detail.PO_Contract_Override_Ind,
    Scorecard_Detail.PO_Definitization_Date,
    Scorecard_Detail.Performance_Management_Type

FROM 
    Scorecard_Detail_Note 
    
INNER JOIN 
    Scorecard_Detail
ON 
    Scorecard_Detail_Note.Scorecard_Detail_SID = Scorecard_Detail.Scorecard_Detail_SID
"""

detail = db.query(SQL_QUERY)
detail["sid_key"] = detail["SID"].apply(lambda x: f"{x:06d}") + "." + detail["Note_Year"].astype(str) + "." + detail["Note_Month"].astype(str)

