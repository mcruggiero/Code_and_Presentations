{
  "settings": {
    "number_of_shards": 5,
    "number_of_replicas": 2,
    "index.mapping.total_fields.limit": 10000
  },
  "mappings": {
    "dynamic_templates": [
      {
        "strings_as_text": {
          "match_mapping_type": "string",
          "mapping": { "type": "text" }
        }
      }
    ],
    "properties": {
      "name": { "type": "text" },
      "sheet_name": { "type": "text" },
      "extension": { "type": "text" },
      "creator": { "type": "text" },
      "last_modified_by": { "type": "text" },
      "title": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 2048
          }
        }
      },
      "keywords": { "type": "text" },
      "path": { "type": "text" },
      "created": { "type": "date", "format": "yyyy-MM-dd" },
      "modified": { "type": "date", "format": "yyyy-MM-dd" },
      "ai_text": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 2048
          }
        }
      },
      "information": { "type": "text" },
      "other": { "type": "text" },

      "ai_scores": {
        "type": "object",
        "properties": {
          "clarity": { "type": "long" },
          "accuracy": { "type": "long" },
          "actionability": { "type": "long" },
          "score": { "type": "long" }
        }
      },

      "ai_update": { "type": "date", "format": "yyyy-MM-dd" },

      "step_json": {
        "type": "nested",
        "properties": {
          "Step Number": { "type": "long" },
          "Step Description": { "type": "text" },
          "Step Expected Result": { "type": "text" },
          "Details": {
            "type": "object",
            "properties": {
              "Field Instructions": {
                "type": "object",
                "properties": {
                  "Field": { "type": "text" },
                  "Value": { "type": "text" }
                }
              },
              "SAP T-code": { "type": "text" }
            }
          },
          "Detailed Instructions": {
            "type": "object",
            "properties": {
              "Action": { "type": "text" },
              "Field": { "type": "text" },
              "Value": { "type": "text" }
            }
          }
        }
      },

      "ai_json": {
        "type": "nested",
        "properties": {
          "Step Number": { "type": "long" },
          "Step Description": { "type": "text" },
          "Step Expected Result": { "type": "text" },
          "Details": {
            "type": "object",
            "properties": {
              "Field Instructions": {
                "type": "object",
                "properties": {
                  "Field": { "type": "text" },
                  "Value": { "type": "text" }
                }
              },
              "SAP T-code": { "type": "text" }
            }
          },
          "Detailed Instructions": {
            "type": "object",
            "properties": {
              "Action": { "type": "text" },
              "Field": { "type": "text" },
              "Value": { "type": "text" }
            }
          }
        }
      },

      "metrics": {
        "type": "nested",
        "properties": {
          "name": { "type": "text" },
          "value": { "type": "float" },
          "note": { "type": "text" },
          "timestamp": { "type": "date", "format": "strict_date_optional_time||epoch_millis" }
        }
      },

      "schema_version": { "type": "keyword" },
      "tags": { "type": "keyword" },
      "status": { "type": "keyword" },
      "ai_model": { "type": "keyword" },
      "reviewed_by": { "type": "keyword" },
      "review_status": { "type": "keyword" },
      "step_count": { "type": "integer" },
      "token_count": { "type": "integer" },
      "source_pipeline": { "type": "keyword" },
      "ingest_time": { "type": "date", "format": "strict_date_optional_time||epoch_millis" }
    }
  }
}
