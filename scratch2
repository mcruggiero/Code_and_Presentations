from elasticsearch import Elasticsearch, helpers
import hashlib
import re

# === Connect to your OpenSearch / Elasticsearch cluster ===
os_client = Elasticsearch("http://localhost:9200")

# === Constants ===
OLD_ALIAS = "main_index"
NEW_ALIAS = "dev_index"
SCROLL_TIME = "2m"
BATCH_SIZE = 500

# === Step 1: Scroll all documents from old alias ===
results = []
scroll = os_client.search(
    index=OLD_ALIAS,
    scroll=SCROLL_TIME,
    size=BATCH_SIZE,
    body={"query": {"match_all": {}}}
)

scroll_id = scroll["_scroll_id"]
hits = scroll["hits"]["hits"]
results.extend(hits)

while len(hits) > 0:
    scroll = os_client.scroll(scroll_id=scroll_id, scroll=SCROLL_TIME)
    scroll_id = scroll["_scroll_id"]
    hits = scroll["hits"]["hits"]
    results.extend(hits)

print(f"Total documents to reindex: {len(results)}")

# === Step 2: Reindex with custom _id while preserving suffix like _v000 ===
actions = []

for doc in results:
    source = doc["_source"]

    try:
        # Extract version suffix (_v000, _v001...) from existing os_index field
        version_match = re.search(r"_v\d{3}$", source.get("os_index", ""))
        suffix = version_match.group(0) if version_match else "_v000"

        # Build the new ID from portfolio, path, test_case_name + version suffix
        raw_id = f"{source['portfolio']}\n{source['path']}\n{source['test_case_name']}{suffix}"
        new_id = hashlib.sha256(raw_id.encode()).hexdigest()

        # Build reindex action
        actions.append({
            "_index": NEW_ALIAS,
            "_id": new_id,
            "_source": source
        })

    except KeyError as e:
        print(f"⚠️ Skipping doc due to missing key: {e}")
        continue

# === Step 3: Bulk insert into dev_index ===
helpers.bulk(os_client, actions)
print(f"✅ Reindexed {len(actions)} docs to {NEW_ALIAS} with version-aware IDs.")
